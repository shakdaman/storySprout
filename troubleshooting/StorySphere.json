    {
      "parameters": {
        "jsCode": "// Parse the JSON response from Idea Spark\nconst response = $input.first().json;\nconst content = response.content[0].text;\n\ntry {\n  const parsedContent = JSON.parse(content);\n  return {\n    json: parsedContent\n  };\n} catch (error) {\n  throw new Error('Failed to parse JSON from Idea Spark: ' + error.message);\n}"
      },
      "id": "7188f2dd-5ee8-4f41-a30c-63334406bd23",
      "name": "Parse Idea JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
