      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the JSON response from Plot Architect\nconst response = $input.first().json;\nconst content = response.content[0].text;\n\ntry {\n  const parsedContent = JSON.parse(content);\n  return {\n    json: parsedContent\n  };\n} catch (error) {\n  throw new Error('Failed to parse JSON from Plot Architect: ' + error.message);\n}"
      },
      "id": "044629c0-74ad-4e65-a180-9bc57b2090ce",
      "name": "Parse Plot JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Split the story into scenes for image generation\nconst storyText = $input.first().json.content[0].text;\nconst plotData = $('Parse Plot JSON').first().json;\n\n// Split story into paragraphs\nconst paragraphs = storyText.split('\\n\\n').filter(p => p.trim().length > 0);\n\n// Create scenes based on plot points\nconst scenes = [];\nconst plotPoints = plotData.plot_points || [];\n\nfor (let i = 0; i < Math.min(paragraphs.length, plotPoints.length); i++) {\n  scenes.push({\n    scene_number: i + 1,\n    scene_title: plotPoints[i]?.title || `Scene ${i + 1}`,\n    scene_text: paragraphs[i].trim(),\n    story_title: plotData.title,\n    characters: plotData.characters\n  });\n}\n\nreturn scenes.map(scene => ({ json: scene }));"
      },
      "id": "52f5318c-6a1a-49d1-babc-ec385806b457",
      "name": "Split Into Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1952,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://queue.fal.run/fal-ai/nano-banana",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "falAiApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
