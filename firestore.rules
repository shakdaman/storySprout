rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write their own data
    match /parents/{parentId} {
      allow read, write: if request.auth != null && request.auth.uid == parentId;
    }
    
    // Allow parents to read/write their children's data
    match /children/{childId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow reading stories and quizzes (public content)
    match /stories/{storyId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Allow authenticated users to read/write quiz results and activities
    match /quizResults/{resultId} {
      allow read, write: if request.auth != null;
    }
    
    match /readingActivities/{activityId} {
      allow read, write: if request.auth != null;
    }
    
    match /childProgress/{progressId} {
      allow read, write: if request.auth != null;
    }
    
    match /achievements/{achievementId} {
      allow read, write: if request.auth != null;
    }
    
    // N8N Automation Collections
    // Allow authenticated users to read n8n story data
    match /n8nStories/{storyId} {
      allow read: if request.auth != null;
      // Only allow write for system/admin operations (you may want to restrict this further)
      allow write: if request.auth != null;
    }
    
    // Allow authenticated users to read email campaigns
    match /emailCampaigns/{campaignId} {
      allow read: if request.auth != null;
      // Only allow write for system/admin operations
      allow write: if request.auth != null;
    }
  }
}
